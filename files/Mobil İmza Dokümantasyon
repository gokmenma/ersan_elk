Servis Sağlayıcı, Turkcell MSSP’ye imza isteğini gönderirken:
 

Prod URL’i : https://msign.turkcell.com.tr/MSSP2/services/MSS_Signature?wsdl
 

Örnek Request:
 

<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:soap="http://turkcelltech.com/mobilesignature/validation/soap" xmlns:v1="http://uri.etsi.org/TS102204/v1.1.2#">
   <soapenv:Header/>
   <soapenv:Body>
      <soap:MSS_Signature>
         <MSS_SignatureReq MajorVersion="1" MessagingMode="synch" MinorVersion="1" TimeOut="30">
            <v1:AP_Info AP_ID="http://***" AP_PWD="***123" AP_TransID="_12647******" AP_URL="" Instant="2009-12-22T08:23:38.778Z"/>
            <v1:MSSP_Info>
               <v1:MSSP_ID/>
            </v1:MSSP_Info> 
            <v1:MobileUser>
               <v1:MSISDN>05*********</v1:MSISDN>
            </v1:MobileUser>
            <v1:DataToBeSigned Encoding="Base64" MimeType="application/octet-stream">+vLmZ1MH57M2GvI/+xDmrq7RKzg1Dv53YytK/822R+Q=</v1:DataToBeSigned>
            <v1:DataToBeDisplayed Encoding="UTF-8" MimeType="text/plain">TEST</v1:DataToBeDisplayed>
            <v1:SignatureProfile>
               <v1:mssURI>http://uri.turkcellteknoloji.com.tr/MobileSignature/profile2</v1:mssURI>
            </v1:SignatureProfile>
            <v1:MSS_Format>
               <v1:mssURI>http://uri.etsi.org/TS102204/v1.1.2#PKCS7</v1:mssURI>
            </v1:MSS_Format>
         </MSS_SignatureReq>
      </soap:MSS_Signature>
   </soapenv:Body>
</soapenv:Envelope>
 

Turkcell MSSP platformu Servis Sağlayıcıya response olarak aşağıdaki gibi döner:
 

Örnek response:
 

<soap:Envelope xmlns:soap="http://www.w3.org/2003/05/soap-envelope">
   <soap:Body>
      <ns1:MSS_SignatureResponse xmlns:ns1="http://turkcelltech.com/mobilesignature/validation/soap">
         <MSS_SignatureResp MSSP_TransID="_655324" MajorVersion="1" MinorVersion="1" xmlns:ns2="http://www.w3.org/2000/09/xmldsig#" xmlns:ns3="http://www.w3.org/2003/05/soap-envelope" xmlns:ns4="http://www.w3.org/2001/04/xmlenc#" xmlns:ns5="http://uri.etsi.org/TS102204/v1.1.2#">
            <ns5:AP_Info AP_ID="http://***" AP_TransID="_12647*****" AP_PWD="***123" Instant="2009-12-22T08:23:38.778Z" AP_URL=""/>
            <ns5:MSSP_Info Instant="2020-02-16T18:00:11.208+02:00">
               <ns5:MSSP_ID/>
            </ns5:MSSP_Info>
            <ns5:MobileUser>
               <ns5:MSISDN>05*********</ns5:MSISDN>
            </ns5:MobileUser>
            <ns5:MSS_Signature>
               <ns5:Base64Signature>PFNpZ25hdHVyZVZhbHVlIElkPSJTaWduYXR…</ns5:Base64Signature>
            </ns5:MSS_Signature>
            <ns5:SignatureProfile>
               <ns5:mssURI>http://uri.turkcellteknoloji.com.tr/MobileSignature/profile2</ns5:mssURI>
            </ns5:SignatureProfile>
            <ns5:Status>
               <ns5:StatusCode Value="500"/>
               <ns5:StatusMessage>SIGNATURE</ns5:StatusMessage>
            </ns5:Status>
         </MSS_SignatureResp>
      </ns1:MSS_SignatureResponse>
   </soap:Body>
</soap:Envelope>
 

 

